<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg_primary | default: '#060B16' }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'Catracada | Natural Zone' }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Catracada & Natural Zone - Suplementos de alta performance: Catracada Test, Black Dragon Test, Catracada Turbo, Pré-Treinos, Creatinas e Combos com 10% OFF no PIX e envio em até 24h para SP.">
  {% endif %}

  <!-- Open Graph / SEO Structured Meta -->
  <meta property="og:site_name" content="{{ shop.name | default: 'Catracada | Natural Zone' }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:description" content="{{ page_description | default: shop.name | escape }}">

  <!-- Google Fonts: Montserrat & Inter para máxima legibilidade e impacto -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:ital,wght@0,700;0,800;0,900;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Design Tokens Dinâmicos do Shopify Theme Editor -->
  <style>
    :root {
      --color-bg-primary: {{ settings.color_bg_primary | default: '#060B16' }};
      --color-bg-secondary: {{ settings.color_bg_secondary | default: '#0D172A' }};
      --color-bg-card: {{ settings.color_bg_card | default: '#13203B' }};
      --color-border-subtle: #1E325C;
      --color-text-primary: {{ settings.color_text_primary | default: '#FFFFFF' }};
      --color-text-secondary: {{ settings.color_text_secondary | default: '#CBD5E1' }};
      --color-text-muted: #94A3B8;
      --color-accent-red: {{ settings.color_accent_red | default: '#E3242B' }};
      --color-accent-red-hover: {{ settings.color_accent_red_hover | default: '#FF2A32' }};
      --color-accent-red-glow: rgba(227, 36, 43, 0.38);
      --font-heading: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
  </style>

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ 'animations.css' | asset_url | stylesheet_tag }}
  {{ 'responsive.css' | asset_url | stylesheet_tag }}

  <!-- Injeção Obrigatória de Scripts, Pixels e Integrações Nativas da Shopify -->
  {{ content_for_header }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
</head>

<body class="template-{{ template.name | handle }}">
  <a class="skip-to-content-link" href="#MainContent">
    {{ 'general.accessibility.skip_to_text' | t }}
  </a>

  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <!-- Gaveta Lateral do Carrinho (Shopify Ajax Cart API) -->
  {% render 'cart-drawer' %}

  <!-- Botão Flutuante de WhatsApp Oficial -->
  <a
    href="https://wa.me/{{ settings.whatsapp_number | default: '5511985538439' }}?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20Catracada%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida."
    class="whatsapp-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Atendimento via WhatsApp"
  >
    {% render 'icon', icon: 'whatsapp' %}
    <span class="whatsapp-float__label">Falar com Especialista</span>
  </a>

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
