{% render 'breadcrumbs' %}

<section class="main-collection-section container" style="padding: 2.5rem 1.25rem 4rem;">
  <div class="section-header">
    <span class="section-eyebrow">COLEÇÃO OFICIAL</span>
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="section-subtitle">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by 12 -%}
    {%- if collection.products.size > 0 -%}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align:center; color: var(--color-text-secondary); padding: 3rem 0;">
        Nenhum produto cadastrado nesta categoria no momento.
      </p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div style="margin-top: 2.5rem; text-align: center;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Coleção Principal",
  "settings": []
}
{% endschema %}
